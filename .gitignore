# 运行时产物（可由工程与接口重新生成）
cache/
exports/
drafts/
asr/
__pycache__/
*.pyc

# 会话状态：含本机工程绝对路径与未写回改动，不入库
studio_state.json
studio_state.json.*

# 工作区记忆/会话数据（含本机路径与内部记录）
.workbuddy/

# 可能包含密钥的本地配置（config/ 下的模板与校准要入库，只有本机 LLM 配置忽略）
llm_config.json
config/llm_config.json
config/library.json
.env

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 打包 / 测试 / 类型检查产物
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/

# 编辑器与临时重构文件
*.bak
*.tmp
.idea/
.vscode/
